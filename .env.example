# Copy to .env only when you use a real model. .env is ignored by Git and never needed for the demo or the tests.
# The tool reads these variables from the shell; `npm run audit` and `npm run test:live` also load .env.

# LLM provider: none, fake or openai-compatible. Default: fake (lenient, bundled scripted answers, no network).
# npm run demo always uses the strict fake and ignores this variable.
LLM_PROVIDER=
# Required with openai-compatible (at least 8 characters). Keep it empty here: never commit a real key.
LLM_API_KEY=
# OpenAI-compatible base URL: https, or http on loopback only. Default: https://openrouter.ai/api/v1
LLM_BASE_URL=
# Model name. Required with openai-compatible.
LLM_MODEL=
# Timeout of one LLM request in milliseconds, 1000 to 120000. Default: 30000
LLM_TIMEOUT_MS=
# JSON object merged over the request body; a null value deletes a field. Default: empty.
# Example: {"max_tokens":null,"max_completion_tokens":300,"temperature":null}
LLM_REQUEST_OVERRIDES=
# Directory that SARIF uri values are relative to. Default: GITHUB_WORKSPACE, else the current directory.
A11Y_REPO_ROOT=
# Path to a Chromium executable (must exist). Default: empty, so Playwright's own Chromium is used
# (install it with: npm run browser:install). Example, the puppeteer headless shell on an Apple-silicon Mac:
# A11Y_BROWSER_PATH=$HOME/.cache/puppeteer/chrome-headless-shell/mac_arm-155.0.8059.39/chrome-headless-shell-mac-arm64/chrome-headless-shell
A11Y_BROWSER_PATH=
# Tests and demo: 1 turns "no browser found" from a skip into a failure. CI sets it. Default: empty.
REQUIRE_BROWSER=
# Same effect as REQUIRE_BROWSER=1 when set to anything but empty, 0 or false. Default: empty.
CI=
# debug, info, warn or error. Default: info
LOG_LEVEL=
# Output directory of npm run audit. Default: reports/latest
A11Y_OUT=
